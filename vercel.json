{
  "trailingSlash": false,
  "redirects": [
    { "source": "/engagements", "destination": "/advisory", "permanent": true },
    { "source": "/engagements/:slug", "destination": "/advisory/:slug", "permanent": true },
    { "source": "/perspective", "destination": "/about", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/advisory", "destination": "/index.html" },
    { "source": "/advisory/red-to-ready-turnaround", "destination": "/index.html" },
    { "source": "/advisory/the-delivery-office", "destination": "/index.html" },
    { "source": "/advisory/managed-services-builder", "destination": "/index.html" },
    { "source": "/advisory/process-to-platform", "destination": "/index.html" },
    { "source": "/advisory/commercial-command", "destination": "/index.html" },
    { "source": "/advisory/ai-that-works", "destination": "/index.html" },
    { "source": "/gcc", "destination": "/index.html" },
    { "source": "/ai", "destination": "/index.html" },
    { "source": "/evidence", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/health-check", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/booked", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://cal.com https://app.cal.com; connect-src 'self' https://api.cal.com https://app.cal.com https://www.google-analytics.com https://region1.google-analytics.com; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
