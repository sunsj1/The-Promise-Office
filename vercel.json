{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/engagements", "destination": "/index.html" },
    { "source": "/engagements/red-to-ready-turnaround", "destination": "/index.html" },
    { "source": "/engagements/the-delivery-office", "destination": "/index.html" },
    { "source": "/engagements/managed-services-builder", "destination": "/index.html" },
    { "source": "/engagements/process-to-platform", "destination": "/index.html" },
    { "source": "/engagements/commercial-command", "destination": "/index.html" },
    { "source": "/engagements/ai-that-works", "destination": "/index.html" },
    { "source": "/evidence", "destination": "/index.html" },
    { "source": "/perspective", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/health-check", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/booked", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://cal.com https://app.cal.com; connect-src 'self' https://api.cal.com https://app.cal.com; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
